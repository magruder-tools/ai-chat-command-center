{
  "name": "chatgpt-command-center",
  "version": "0.3.1",
  "private": true,
  "description": "A local-first Chrome command center for tracked ChatGPT and Claude conversations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/magruder-tools/ai-chat-command-center.git"
  },
  "homepage": "https://github.com/magruder-tools/ai-chat-command-center#readme",
  "bugs": {
    "url": "https://github.com/magruder-tools/ai-chat-command-center/issues"
  },
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-extension.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshot": "node scripts/capture-screenshots.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e",
    "release": "pnpm build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
